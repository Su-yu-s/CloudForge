{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudForge",
  "version": "0.1.0",
  "identifier": "com.cloudforge.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudForge · 点云几何工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
